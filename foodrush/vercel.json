{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.foodrush.id.vn/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://api.foodrush.id.vn/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://api.foodrush.id.vn/login/oauth2/:path*"
    }
  ]
}